# Copia este archivo a ".env" y completa tus datos reales.
# El .env NUNCA debe subirse a un repositorio público (agrégalo a .gitignore).

# Cuenta de Gmail que ENVÍA los correos del formulario
EMAIL_USER=tu_correo@gmail.com

# Contraseña de aplicación de Gmail (NO tu contraseña normal)
# Genera una en: https://myaccount.google.com/apppasswords
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# Correo que RECIBE los formularios (contacto y agendar sesión)
EMAIL_TO=soporte.aban@gmail.com

# Puerto del servidor (opcional)
PORT=3000
